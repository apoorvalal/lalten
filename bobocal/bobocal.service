[Unit]
Description=bobocal (Streamlit)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/lalten/bobocal
Environment=PYTHONUNBUFFERED=1
Environment=BOBOCAL_DB_PATH=/root/lalten/data/bobocal.sqlite
# Set this to wherever your Obsidian vault is on the server (must be writable by the service user)
Environment=BOBOCAL_OBSIDIAN_BASE=/Users/alal/Documents/PersonalVault/KrabbiePatties
ExecStart=/root/lalten/bobocal/.venv/bin/streamlit run /root/lalten/bobocal/app.py --server.address=127.0.0.1 --server.port=8503 --server.baseUrlPath=bobocal --server.headless=true --browser.gatherUsageStats=false
Restart=on-failure
RestartSec=2

# Hardening (light)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
